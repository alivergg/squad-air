# Maintainer: SquadAir Contributors <support@squadair.app>
pkgname=squad-air-bin
pkgver=1.6
pkgrel=1
pkgdesc="Ultra-lightweight, zero-knowledge P2P voice chat and 1080p60 screen sharing built in pure Rust"
arch=('x86_64')
url="https://squadair.app/"
license=('AGPL-3.0-only')
depends=(
  'alsa-lib'
  'gtk3'
  'libx11'
  'libxcb'
  'libxkbcommon'
  'libayatana-appindicator'
  'opus'
)
provides=('squad-air')
conflicts=('squad-air')
source=("squad-air-${pkgver}-1-x86_64.pkg.tar.zst::https://github.com/alivergg/squad-air/releases/download/v1.6/squad-air-1.6-1-x86_64.pkg.tar.zst")
sha256sums=('f13f0db4e46463e6fa70ffcc3fe5c1b8523cfc2577a3b377246cf24be71b9b5e')

package() {
  cp -a "${srcdir}/usr" "${pkgdir}/"
  install -dm755 "${pkgdir}/usr/share/licenses/${pkgname}"
  ln -sf ../squad-air/LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
